pipeline {
    agent any

    tools {
        terraform 'terraform-1.17'
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_DEFAULT_REGION    = 'ap-south-1'
    }

    stages {
        stage('Checkout & Validate') {
            steps {
                dir('terraform') {
                    bat 'if exist tfplan del /f /q tfplan'
                    bat 'terraform init -reconfigure'
                    bat 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    bat 'terraform plan -out=tfplan'
                }
            }
        }

        stage('Approval Gate') {
            input {
                message 'Review terraform plan above. Approve provisioning EC2?'
                ok 'Deploy Infrastructure'
            }
            steps {
                echo 'Approval granted. Proceeding to apply...'
                }
        }

       stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    bat 'terraform apply -auto-approve tfplan'
                    bat 'terraform output -raw ec2_public_ip'
                }
            }
        }
    }
}